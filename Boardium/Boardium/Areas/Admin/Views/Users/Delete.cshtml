@using Microsoft.AspNetCore.Mvc.TagHelpers
@model Boardium.Models.Auth.ApplicationUser
@{
    ViewData["Title"] = "Delete User";
}

<h1 class="mb-4 text-danger">Delete User</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this user?
</div>

<div class="card p-4 mb-3">
    <dl class="row">
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">First Name</dt>
        <dd class="col-sm-9">@Model.FirstName</dd>

        <dt class="col-sm-3">Last Name</dt>
        <dd class="col-sm-9">@Model.LastName</dd>
    </dl>
</div>

<form asp-area="Admin" asp-controller="Users" asp-action="DeleteConfirmed">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Yes, delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>