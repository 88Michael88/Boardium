@using Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<Boardium.Models.Auth.ApplicationUser>
@{
    ViewData["Title"] = "Użytkownicy";
}

<h1 class="mb-4">Lista użytkowników</h1>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
    <tr>
        <th>Email</th>
        <th>First Name</th>
        <th>Last Name</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var user in Model)
    {
        <tr>
            <td>@user.Email</td>
            <td>@user.FirstName</td>
            <td>@user.LastName</td>
            <td>
                <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-info">Details</a>
                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-warning">Edit</a>
            </td>
        </tr>
    }
    </tbody>
</table>
<nav aria-label="User pagination">
    <ul class="pagination">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
            </li>
        }
    </ul>
</nav>