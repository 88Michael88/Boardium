@using Boardium.Models.Rental
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model Boardium.Models.Rental.Rental

@{
    ViewData["Title"] = "Process Rental";
    var user = Model.ApplicationUser;
}
<h1>Process Order</h1>

<hr/>

        <form asp-action="Process">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id"/>
            <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label">Customer</label>
                    <p class="form-control-plaintext">
                        @user.FirstName @user.LastName (<a href="mailto:@user.Email">@user.Email</a>)
                    </p>
                </div>

                <div class="mb-3">
                    <label asp-for="PickupCode" class="form-label"></label>
                    <p class="form-control-plaintext">@Model.PickupCode</p>
                </div>
                <div class="mb-3">
                    <label asp-for="RentedAt" class="form-label"></label>
                    <input asp-for="RentedAt" type="datetime-local" class="form-control"/>
                </div>

                <div class="mb-3">
                    <label asp-for="DueDate" class="form-label"></label>
                    <input asp-for="DueDate" type="datetime-local" class="form-control"/>
                </div>

                <div class="mb-3">
                    <label asp-for="ReturnedAt" class="form-label"></label>
                    <input asp-for="ReturnedAt" type="datetime-local" class="form-control"/>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Status" class="form-label"></label>
                    <input type="range" min="0" max="@(Enum.GetValues(typeof(RentalStatus)).Length - 1)"
                           value="@Model.Status"
                           class="form-range" id="statusSlider" name="Status"/>
                    <div><strong id="statusLabel">@Model.Status</strong></div>
                </div>
                <div class="form-group">
                    <label asp-for="Notes" class="control-label"></label>
                    <input asp-for="Notes" class="form-control"/>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="RentalFee" class="control-label"></label>
                    <input asp-for="RentalFee" class="form-control"/>
                    <span asp-validation-for="RentalFee" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="LateFee" class="control-label"></label>
                    <input asp-for="LateFee" class="form-control"/>
                    <span asp-validation-for="LateFee" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="DamageFee" class="control-label"></label>
                    <input asp-for="DamageFee" class="form-control"/>
                    <span asp-validation-for="DamageFee" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="PaidFee" class="control-label"></label>
                    <input asp-for="PaidFee" class="form-control"/>
                    <span asp-validation-for="PaidFee" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="Save" class="btn btn-primary"/>
                </div>
            </div>
            </div>
        </form>
   


<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    <script>
        const statusSlider = document.getElementById('statusSlider');
        const statusLabel = document.getElementById('statusLabel');

        const statusLabels = @Html.Raw(Json.Serialize(Enum.GetNames(typeof(Boardium.Models.Rental.RentalStatus))));

        statusSlider.addEventListener('input', () => {
            statusLabel.textContent = statusLabels[statusSlider.value];
        });
    </script>
}